{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-scope.dev/schema/trace-event.json",
  "title": "TraceEvent",
  "description": "唯一写入原语：所有派生实体均由事件流物化而来。字段定义与架构文档 §2.4.1 逐字一致。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "seq",
    "ts",
    "session_id",
    "type",
    "source",
    "labels",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "契约版本，固定为 SCHEMA_VERSION '1.0.0'"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID，字典序即时间序"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "评测执行单元 ID"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "run 内全局单调自增序号，由 T05a collector 的 assign_seq() 在摄入时统一赋号（纯函数：按 (ts, event_id) 排序赋 0..n-1，输入顺序无关、输出确定）；通道适配器写入的 0 仅为摄入前占位值"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "事件发生时间，ISO 8601 UTC，毫秒精度（墙钟）"
    },
    "ts_mono_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "同机单调时钟毫秒值（clock_gettime MONOTONIC / performance.now 来源），用于同机精确耗时计算，跨机不可比"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "被测平台会话 ID"
    },
    "agent_id": {
      "type": "string",
      "description": "产生者智能体 ID（Lead / Teammate / Subagent）"
    },
    "agent_role": {
      "$ref": "#/$defs/AgentRole"
    },
    "parent_agent_id": {
      "type": "string",
      "description": "委托链上的父智能体 ID"
    },
    "trace_id": {
      "type": "string",
      "description": "OpenTelemetry trace id（GenAI 语义约定对齐）"
    },
    "span_id": {
      "type": "string",
      "description": "OpenTelemetry span id"
    },
    "parent_span_id": {
      "type": "string",
      "description": "OpenTelemetry 父 span id"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "labels": {
      "type": "object",
      "additionalProperties": true,
      "description": "维度标签（variant / model / taskset / task_id / team 等），开放结构"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "事件主体（已脱敏；未知字段原样透传），开放结构"
    },
    "raw_ref": {
      "type": "string",
      "description": "原始记录归档指针（file:line 或 jsonl offset）"
    },
    "redacted": {
      "type": "boolean",
      "description": "本事件是否命中脱敏规则"
    }
  },
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "channel"],
      "properties": {
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "version": {
          "type": "string",
          "description": "被测平台版本号（如 dsh 0.2.1-rc.2）"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "degraded": {
          "$ref": "#/$defs/DegradedLevel"
        }
      }
    },
    "Platform": {
      "type": "string",
      "enum": ["codebuddy", "dsh", "generic"]
    },
    "Channel": {
      "type": "string",
      "enum": ["hook", "file", "otlp", "sdk", "cli"]
    },
    "AgentRole": {
      "type": "string",
      "enum": ["lead", "teammate", "subagent", "system"]
    },
    "DegradedLevel": {
      "type": "string",
      "enum": ["L1", "L2", "L3"],
      "description": "降级通道等级（dsh 三重降级链）"
    },
    "EventType": {
      "type": "string",
      "description": "事件类型，共 26 个，逐一与架构文档 §4.1 一致，缺一即返工",
      "enum": [
        "run.start",
        "run.end",
        "session.start",
        "session.end",
        "agent.spawn",
        "agent.stop",
        "turn.start",
        "turn.end",
        "step.start",
        "step.end",
        "llm.request",
        "llm.response",
        "tool.call",
        "tool.result",
        "tool.error",
        "task.create",
        "task.claim",
        "task.update",
        "task.complete",
        "message.send",
        "message.recv",
        "artifact.write",
        "artifact.ref",
        "context.compact",
        "error",
        "metric.custom"
      ]
    }
  }
}
