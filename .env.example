# harness_scope 环境变量样例（只含键与示例值，禁止放真实密钥）

# 数据根目录（默认 ~/.harness_scope/）
HS_HOME=~/.harness_scope
# 采集暂存目录（每 run 一个 NDJSON 文件）
HS_SPOOL_DIR=~/.harness_scope/spool
# SQLite 数据库路径
HS_DB_PATH=~/.harness_scope/db/harness_scope.db

# 轨迹内容采集：off = 只存 hash + 元数据（默认，安全值）
HS_CONTENT_CAPTURE=off
# 云端 LLM-as-Judge：off = 默认禁止，需逐次授权（默认，安全值）
HS_CLOUD_JUDGE=off

# 被测平台 Home 目录示例
CODEBUDDY_HOME=~/.codebuddy
DSH_HOME=~/.dsh
